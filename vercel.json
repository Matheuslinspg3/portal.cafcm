{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/r/:token",
      "destination": "https://cyovnmnxzrfptyfrivdr.supabase.co/functions/v1/link-redirect/:token"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
